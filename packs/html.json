    },
    {
      "id": "forms",
      "title": "Forms and labels",
      "code": "<form action=\"/search\" method=\"get\">\n  <label for=\"plant\">Find a plant</label>\n  <input id=\"plant\" name=\"q\" type=\"search\">\n  <button type=\"submit\">Search</button>\n</form>",
      "explanation": "A labeled search form submitting q in the URL. The /search endpoint is illustrative and needs an application backend.",
      "topics": [
        "forms"
      ],
      "scopes": [
        "block",
        "module"
      ],
      "keywords": [
        "form",
        "label",
        "submit",
        "fieldset",
        "legend",
        "form data"
      ],
      "priority": 0.7
    },
    {
      "id": "inputs",
      "title": "Input types and validation",
      "code": "<label for=\"email\">Email for harvest reminders</label>\n<input id=\"email\" name=\"email\" type=\"email\" required autocomplete=\"email\">\n<label for=\"beds\">Number of beds</label>\n<input id=\"beds\" name=\"beds\" type=\"number\" min=\"1\" max=\"20\" value=\"2\">",
      "explanation": "Offer email and numeric constraints with associated labels. Place controls in a form to submit and trigger native validation.",
      "topics": [
        "inputs"
      ],
      "scopes": [
        "block",
        "module"
      ],
      "keywords": [
        "input",
        "required",
        "email",
        "validation",
        "min",
        "max",
        "autocomplete"
      ],
      "priority": 0.7
    },
    {
      "id": "choices",
      "title": "Selects and multiline text",
      "code": "<label for=\"season\">Planting season</label>\n<select id=\"season\" name=\"season\">\n  <option value=\"spring\">Spring</option>\n  <option value=\"autumn\">Autumn</option>\n</select>\n<label for=\"notes\">Notes</label>\n<textarea id=\"notes\" name=\"notes\" rows=\"3\"></textarea>",
      "explanation": "Collect a season and freeform notes using native keyboard-accessible controls.",
      "topics": [
        "choices"
      ],
      "scopes": [
        "block",
        "module"
      ],
      "keywords": [
        "select",
        "option",
        "textarea",
        "dropdown",
        "multiline"
      ],
      "priority": 0.7
    },
    {
      "id": "buttons",
      "title": "Buttons and disabled state",
      "code": "<button type=\"button\" aria-describedby=\"save-help\" disabled>Save harvest</button>\n<p id=\"save-help\">Enter a harvest date to enable saving.</p>",
      "explanation": "Display an unavailable action and its reason. An application must remove disabled when the prerequisite is met.",
      "topics": [
        "buttons"
      ],
      "scopes": [
        "block",
        "module"
      ],
      "keywords": [
        "button",
        "button type",
        "disabled",
        "reset"
      ],
      "priority": 0.7
    },
    {
      "id": "details",
      "title": "Disclosure widgets",
      "code": "<details>\n  <summary>How often should I water?</summary>\n  <p>Check the soil daily and water when the top feels dry.</p>\n</details>",
      "explanation": "A keyboard-operable help disclosure that works without JavaScript.",
      "topics": [
        "details"
      ],
      "scopes": [
        "block",
        "module"
      ],
      "keywords": [
        "details",
