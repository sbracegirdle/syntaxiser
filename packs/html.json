    },
    {
      "id": "data",
      "title": "Global attributes and data",
      "code": "<article id=\"bed-7\" class=\"garden-card\" data-bed-id=\"7\">\n  <h2>North bed</h2>\n  <p hidden>Archived notes</p>\n</article>",
      "explanation": "A stable CSS hook and application record identifier on a card. Hidden notes remain in the document source.",
      "topics": [
