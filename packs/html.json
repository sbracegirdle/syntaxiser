    {
      "id": "accessibility",
      "title": "Accessible names and status",
      "code": "<button type=\"button\" aria-label=\"Close planting tips\">×</button>\n<p role=\"status\" id=\"save-status\">No changes saved.</p>",
      "explanation": "Name an icon-only action and provide a status region. Wire the button and update the status through application code.",
      "topics": [
        "accessibility"
      ],
      "scopes": [
        "block",
        "module"
      ],
      "keywords": [
        "aria",
        "accessibility",
        "accessible name",
        "screen reader",
