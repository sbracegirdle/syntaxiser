  "cards": [
    {
      "id": "document",
      "title": "Document and metadata",
      "code": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Garden journal</title>\n</head>\n<body><h1>Garden journal</h1></body>\n</html>",
      "explanation": "A complete minimal page with a meaningful title and mobile viewport. Save as index.html and open in a browser.",
      "topics": [
        "document"
      ],
      "scopes": [
        "block",
        "module"
      ],
      "keywords": [
        "doctype",
        "document",
        "metadata",
        "viewport",
        "page title"
      ],
      "priority": 0.7
    },
    {
      "id": "assets",
      "title": "Stylesheets and scripts",
      "code": "<link rel=\"stylesheet\" href=\"./styles.css\">\n<script type=\"module\" src=\"./app.js\"></script>",
      "explanation": "Load local styles and a JavaScript module. Supply styles.css and app.js; serve over HTTP for module loading.",
      "topics": [
        "assets"
      ],
      "scopes": [
        "block",
        "module"
      ],
      "keywords": [
        "stylesheet",
        "link css",
        "script",
        "module script"
      ],
      "priority": 0.7
    },
    {
      "id": "semantics",
      "title": "Semantic page regions",
      "code": "<header><h1>Garden journal</h1></header>\n<nav aria-label=\"Main\"><a href=\"#entries\">Entries</a></nav>\n<main id=\"entries\">\n  <article><h2>First harvest</h2><p>The beans are ready.</p></article>\n</main>\n<footer>Written by the garden club</footer>",
      "explanation": "A small journal page with navigation and a separately titled entry. Native elements provide landmarks without extra roles.",
      "topics": [
        "semantics"
      ],
      "scopes": [
        "block",
        "module"
      ],
      "keywords": [
        "semantic html",
        "landmarks",
        "navigation",
        "main",
        "article",
        "section",
        "header",
        "footer"
      ],
      "priority": 0.7
    },
    {
      "id": "text",
      "title": "Text and inline meaning",
      "code": "<h2>Safety notes</h2>\n<p><strong>Wear gloves.</strong> Check the soil <em>before</em> watering.</p>\n<pre><code>&lt;seed&gt; &amp; water</code></pre>",
      "explanation": "Display literal markup safely while distinguishing important advice from stressed words.",
      "topics": [
        "text"
      ],
      "scopes": [
        "block",
        "module"
      ],
      "keywords": [
        "paragraph",
        "heading",
        "strong",
        "emphasis",
        "code",
        "escape html",
        "entities"
      ],
      "priority": 0.7
    },
    {
      "id": "links",
      "title": "Links and downloads",
      "code": "<a href=\"#planting\">Skip to planting advice</a>\n<h2 id=\"planting\">Planting advice</h2>\n<a href=\"https://developer.mozilla.org/\" target=\"_blank\" rel=\"noopener\">Read MDN (new tab)</a>",
      "explanation": "Navigate within the page and open documentation in a new tab with explicit opener isolation.",
      "topics": [
        "links"
      ],
      "scopes": [
        "block",
        "module"
      ],
      "keywords": [
        "anchor",
        "link",
        "href",
        "download",
        "new tab"
      ],
      "priority": 0.7
    },
    {
      "id": "lists",
      "title": "Lists and descriptions",
      "code": "<ol>\n  <li>Loosen the soil.</li>\n  <li>Plant the seeds.</li>\n  <li>Water gently.</li>\n</ol>\n<dl><dt>Germination</dt><dd>The first growth from a seed.</dd></dl>",
      "explanation": "Show ordered planting steps and a small glossary.",
      "topics": [
        "lists"
      ],
      "scopes": [
        "block",
        "module"
      ],
      "keywords": [
        "unordered list",
        "ordered list",
        "bullet list",
        "description list"
      ],
      "priority": 0.7
    },
    {
      "id": "images",
      "title": "Images and responsive sources",
      "code": "<figure>\n  <img src=\"./seedling.svg\" alt=\"Two leaves sprouting above the soil\" width=\"320\" height=\"180\" loading=\"lazy\">\n  <figcaption>A bean seedling after one week.</figcaption>\n</figure>",
      "explanation": "Caption a locally supplied seedling image, reserve its dimensions, and defer offscreen loading.",
      "topics": [
        "images"
      ],
      "scopes": [
        "block",
        "module"
      ],
      "keywords": [
