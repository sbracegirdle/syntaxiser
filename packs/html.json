    {
      "id": "tables",
      "title": "Accessible data tables",
      "code": "<table>\n  <caption>Seeds planted this week</caption>\n  <thead><tr><th scope=\"col\">Plant</th><th scope=\"col\">Count</th></tr></thead>\n  <tbody><tr><th scope=\"row\">Beans</th><td>12</td></tr></tbody>\n</table>",
      "explanation": "A compact data table with a caption plus row and column headers.",
      "topics": [
        "tables"
