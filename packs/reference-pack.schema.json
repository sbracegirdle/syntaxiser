{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Syntaxiser reference pack",
  "type": "object",
  "required": ["schemaVersion", "languageId", "displayName", "concepts", "cards"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "languageId": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string", "minLength": 1 },
    "concepts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "aliases", "patterns"],
        "properties": {
          "id": { "type": "string" },
          "aliases": { "$ref": "#/$defs/strings" },
          "patterns": { "$ref": "#/$defs/strings" }
        }
      }
    },
    "cards": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "code", "topics", "scopes", "keywords", "priority"],
        "properties": {
          "id": { "type": "string" }, "title": { "type": "string" },
          "code": { "type": "string", "minLength": 1 },
          "explanation": { "type": "string", "minLength": 1, "pattern": "\\S", "description": "Optional plain-text explanation shown on hover, outside the snippet." },
          "topics": { "$ref": "#/$defs/strings", "minItems": 1 },
          "scopes": { "type": "array", "minItems": 1, "items": { "enum": ["module", "function", "type", "trait", "implementation", "block"] } },
          "keywords": { "$ref": "#/$defs/strings" },
          "priority": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  },
  "$defs": { "strings": { "type": "array", "items": { "type": "string" }, "uniqueItems": true } }
}
