{
  "name": "syntaxiser",
  "displayName": "Syntaxiser",
  "description": "An offline contextual syntax reference for Rust, Go, TypeScript, and developer terminals.",
  "version": "0.4.3",
  "publisher": "syntaxiser",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sbracegirdle/syntaxiser.git"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other",
    "Education"
  ],
  "keywords": [
    "rust",
    "reference",
    "syntax",
    "sidebar",
    "go",
    "golang",
    "terminal",
    "shell",
    "typescript"
  ],
  "activationEvents": [
    "onLanguage:rust",
    "onLanguage:go",
    "onStartupFinished",
    "onLanguage:shellscript",
    "onLanguage:typescript",
    "onLanguage:typescriptreact"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "syntaxiser.open",
        "title": "Open Reference",
        "category": "Syntaxiser"
      },
      {
        "command": "syntaxiser.refresh",
        "title": "Refresh Reference",
        "category": "Syntaxiser",
        "icon": "$(refresh)"
      },
      {
        "command": "syntaxiser.terminalContext",
        "title": "Use Active Terminal Context",
        "category": "Syntaxiser"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "syntaxiser",
          "title": "Syntaxiser",
          "icon": "media/reference.svg"
        }
      ]
    },
    "views": {
      "syntaxiser": [
        {
          "id": "syntaxiser.reference",
          "name": "Reference",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "syntaxiser.refresh",
          "when": "view == syntaxiser.reference",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Syntaxiser",
      "properties": {
        "syntaxiser.debounceMs": {
          "type": "number",
          "scope": "resource",
          "default": 350,
          "minimum": 100,
          "maximum": 2000,
          "description": "Pause after cursor movement or edits before updating reference cards."
        },
        "syntaxiser.maxCards": {
          "type": "number",
          "scope": "resource",
          "default": 12,
          "minimum": 3,
          "maximum": 30,
          "description": "Cards shown initially in each reference section. Show more reveals additional matches."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p . && npm run build:webview",
    "build:webview": "esbuild src/webview/highlight.js --bundle --minify --format=iife --target=es2022 --outfile=media/highlight.js --legal-comments=eof",
    "watch": "npm run build:webview && tsc -watch -p .",
    "check:rust": "node scripts/check-rust-pack.cjs",
    "check:rust:core": "node scripts/check-rust-pack.cjs --type-check-core",
    "test": "npm run compile && node --test --test-isolation=none test/*.test.cjs",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --no-dependencies --allow-missing-repository",
    "check:go": "node scripts/check-go-pack.cjs",
    "check:rust:libraries": "node scripts/check-rust-libraries.cjs",
    "check:typescript": "node scripts/check-typescript-pack.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.93.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "jsdom": "^30.1.2",
    "typescript": "^5.6.0"
  }
}
