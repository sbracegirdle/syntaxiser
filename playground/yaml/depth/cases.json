  "yaml-example-github-expressions": {
    "happy": {
      "jobs.title.steps.0.env.PR_TITLE": "${{ github.event.pull_request.title }}"
    },
    "edge": {
      "replace": [
        "if: github.event_name == 'pull_request'",
