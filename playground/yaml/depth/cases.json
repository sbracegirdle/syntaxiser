{
  "yaml-example-yaml-mappings": {
    "happy": {
      "app.server.port": 8080
    },
    "edge": {
      "replace": [
        "8080",
        "0"
      ],
      "assertions": {
        "app.server.port": 0
      }
    },
    "error": {
      "replace": [
        "  server:",
        "\tserver:"
      ],
      "diagnostic": "tab"
    }
  },
  "yaml-example-yaml-sequences": {
    "happy": {
      "targets.1.architectures": [
        "arm64"
      ]
    },
    "edge": {
      "replace": [
        "[arm64]",
        "[]"
      ],
      "assertions": {
        "targets.1.architectures": []
      }
    },
    "error": {
      "replace": [
        "[arm64]",
        "[arm64"
      ],
      "diagnostic": "flow"
    }
  },
  "yaml-example-yaml-scalars": {
    "happy": {
      "enabled": true,
      "account": "00123",
      "optional": null
    },
    "edge": {
      "replace": [
        "optional: null",
        "optional: \"\""
      ],
      "assertions": {
        "optional": ""
      }
    },
    "error": {
