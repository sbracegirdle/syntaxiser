      ],
      "assertions": {
        "jobs.title.if": "${{ !cancelled() && github.event_name == 'pull_request' }}"
      }
    },
    "error": {
      "replace": [
        "github.event_name",
        "githab.event_name"
      ],
      "diagnostic": "githab"
    }
  },
