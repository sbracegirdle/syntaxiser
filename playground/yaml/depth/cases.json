        "needs: [check]"
      ],
      "assertions": {
        "jobs.summary.needs": [
          "check"
        ]
      }
    },
    "error": {
      "replace": [
        "needs: check",
        "needs: absent"
      ],
      "diagnostic": "job"
    }
