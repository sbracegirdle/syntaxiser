  "yaml-example-yaml-quoting": {
    "happy": {
      "message": "Status: ready # verified",
      "path": "C:\\work\\journal"
    },
    "edge": {
      "replace": [
        "Status: ready # verified",
        ""
      ],
      "assertions": {
        "message": ""
      }
    },
    "error": {
      "replace": [
        "\"Status: ready # verified\"",
        "Status: ready # verified"
      ],
      "diagnostic": "mapping"
    }
  },
  "yaml-example-yaml-multiline": {
    "happy": {
      "description": "Build the local journal without external services.",
      "script": "printf 'one\\n'\nprintf 'two\\n'\n"
    },
    "edge": {
      "replace": [
        "description: >-",
        "description: |-"
      ],
      "assertions": {
        "description": "Build the local journal\nwithout external services."
      }
    },
    "error": {
      "replace": [
        "script: |",
        "script: |0"
      ],
      "diagnostic": "indentation"
    }
  },
  "yaml-example-yaml-anchors": {
    "happy": {
      "default_regions": [
        "eu-west-1",
        "ap-southeast-2"
      ]
    },
    "edge": {
