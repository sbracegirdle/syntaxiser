{
  "schemaVersion": 1,
  "cards": [
    {
      "id": "function-label",
      "shells": [
        "bash",
        "zsh"
      ],
      "tests": [
        {
          "kind": "happy",
          "files": {},
          "out": "label:release\naccepted\ncaller continues\nouter:parent\n",
          "args": [
            "release"
          ],
          "status": 0
        },
        {
          "kind": "edge",
          "files": {},
          "out": "label:a b\naccepted\ncaller continues\nouter:parent\n",
          "args": [
            "a b"
          ],
          "status": 0
        },
        {
          "kind": "error",
          "files": {},
          "out": "rejected\ncaller continues\nouter:parent\n",
          "args": [],
          "status": 0
        }
      ]
    },
    {
      "id": "function-isolation",
      "shells": [
        "bash",
        "zsh",
        "sh"
      ],
      "tests": [
        {
          "kind": "happy",
          "files": {
            "folder/.keep": ""
          },
          "out": "$DIR/folder\ninspected\nparent preserved\n",
          "args": [
            "folder"
          ],
          "status": 0
        },
        {
          "kind": "edge",
          "files": {},
          "out": "$DIR\ninspected\nparent preserved\n",
          "args": [],
          "status": 0
        },
        {
          "kind": "error",
          "files": {},
          "out": "missing\nparent preserved\n",
          "args": [
            "absent"
          ],
          "status": 0,
          "errMatch": "absent"
        }
      ]
    },
